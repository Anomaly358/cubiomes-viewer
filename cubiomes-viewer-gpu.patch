diff --git a/tests/gpu_host_test.cpp b/tests/gpu_host_test.cpp
new file mode 100644
index 0000000..ac27222
--- /dev/null
+++ b/tests/gpu_host_test.cpp
@@ -0,0 +1,146 @@
+// Exercises GpuFilter (src/gpusearch.cpp) end to end against a mock OpenCL
+// driver and compares the survivors with a brute-force cubiomes reference.
+#include "search.h"
+#include "gpusearch.h"
+#include <algorithm>
+#include <cstdio>
+#include <random>
+#include <set>
+
+extern "C" int getStructureConfig_override(int stype, int mc, StructureConfig *sconf)
+{ return getStructureConfig(stype, mc, sconf); }
+
+ConditionTree::~ConditionTree() {}
+
+static Condition mk(int type, int x1, int z1, int x2, int z2, int count, int relative, int save)
+{
+    Condition c; memset(&c, 0, sizeof(c));
+    c.type = type; c.x1 = x1; c.z1 = z1; c.x2 = x2; c.z2 = z2;
+    c.count = count; c.relative = relative; c.save = save;
+    return c;
+}
+
+static int floordivi(int a, int b) { int q = a / b; if ((a % b) && ((a < 0) != (b < 0))) q--; return q; }
+
+// reference for one root condition (same semantics as the CPU search before biome checks)
+static bool refCond(const Condition& c, int mc, uint64_t seed)
+{
+    const FilterInfo& fi = g_filterinfo.list[c.type];
+    StructureConfig sc; getStructureConfig(fi.stype, mc, &sc);
+    int rs = sc.regionSize << 4, cnt = 0;
+    for (int rz = floordivi(c.z1, rs); rz <= floordivi(c.z2, rs); rz++)
+        for (int rx = floordivi(c.x1, rs); rx <= floordivi(c.x2, rs); rx++)
+        {
+            Pos p;
+            if (!getStructurePos(fi.stype, mc, seed, rx, rz, &p)) continue;
+            if (p.x < c.x1 || p.x > c.x2 || p.z < c.z1 || p.z > c.z2) continue;
+            cnt++;
+        }
+    return cnt >= c.count;
+}
+
+static int fails = 0;
+#define CHECK(cond, ...) do { if (!(cond)) { printf("FAIL: " __VA_ARGS__); printf("\n"); fails++; } } while (0)
+
+int main()
+{
+    const int mc = MC_1_18;
+    ConditionTree tree;
+    tree.condvec.resize(8);
+    tree.references.resize(8);
+    tree.condvec[0] = mk(F_SELECT, 0,0,0,0, 0, 0, 0);
+    tree.condvec[1] = mk(F_VILLAGE,  -350,-350, 350, 350, 3, 0, 1);   // used
+    tree.condvec[2] = mk(F_MONUMENT, -450,-450, 450, 450, 1, 0, 2);   // used
+    tree.condvec[3] = mk(F_OUTPOST,   -500, -500,  500,  500, 2, 1, 3);   // child of 1: ignored
+    tree.condvec[4] = mk(F_HUT,       -500, -500,  500,  500, 0, 0, 4);   // exclusion: ignored
+    tree.condvec[5] = mk(F_BIOME,     -500, -500,  500,  500, 1, 0, 5);   // biome filter: ignored
+    tree.references[0] = {1, 2, 4, 5};
+    tree.references[1] = {3};
+
+    GpuFilter gf;
+    QString info;
+    CHECK(gf.init(tree, mc, &info), "init failed: %s", info.c_str());
+    printf("device: %s, conditions on GPU: %d\n", gf.deviceName().c_str(), gf.conditionCount());
+    CHECK(gf.conditionCount() == 2, "expected 2 GPU conditions, got %d", gf.conditionCount());
+
+    // 1) consecutive range vs brute force
+    {
+        uint64_t base = 0xfedcba9876543210ULL, n = 400000;
+        std::vector<uint64_t> got;
+        CHECK(gf.filterRange(base, n, got, nullptr), "filterRange failed");
+        CHECK(std::is_sorted(got.begin(), got.end()), "range result not sorted");
+        std::set<uint64_t> exp;
+        for (uint64_t i = 0; i < n; i++)
+        {
+            uint64_t s = base + i;
+            if (refCond(tree.condvec[1], mc, s) && refCond(tree.condvec[2], mc, s)) exp.insert(s);
+        }
+        std::set<uint64_t> gs(got.begin(), got.end());
+        CHECK(gs == exp, "range survivors differ: got %zu expected %zu", gs.size(), exp.size());
+        printf("range: %zu/%llu seeds survive (exact match with reference)\n", exp.size(), (unsigned long long)n);
+        CHECK(!exp.empty() && exp.size() < n / 2, "test is not selective enough");
+    }
+
+    // 2) low 48-bit range crossing 0 boundary of the counter (start at 0)
+    {
+        std::vector<uint64_t> got;
+        CHECK(gf.filterRange(0, 100000, got, nullptr), "filterRange(0) failed");
+        std::set<uint64_t> exp;
+        for (uint64_t s = 0; s < 100000; s++)
+            if (refCond(tree.condvec[1], mc, s) && refCond(tree.condvec[2], mc, s)) exp.insert(s);
+        CHECK(std::set<uint64_t>(got.begin(), got.end()) == exp, "range-from-0 differs");
+    }
+
+    // 3) explicit list (shuffled)
+    {
+        std::mt19937_64 rng(7);
+        std::vector<uint64_t> list(150000);
+        for (auto& s : list) s = rng();
+        std::vector<uint64_t> got;
+        CHECK(gf.filterList(list.data(), list.size(), got, nullptr), "filterList failed");
+        std::set<uint64_t> exp;
+        for (uint64_t s : list)
+            if (refCond(tree.condvec[1], mc, s) && refCond(tree.condvec[2], mc, s)) exp.insert(s);
+        CHECK(std::set<uint64_t>(got.begin(), got.end()) == exp, "list survivors differ");
+        printf("list: %zu/%zu survive\n", exp.size(), list.size());
+    }
+
+    // 4) survivor-buffer overflow: nearly everything passes (> 2^20 survivors per launch)
+    {
+        ConditionTree t2;
+        t2.condvec.resize(2); t2.references.resize(2);
+        t2.condvec[0] = mk(F_SELECT, 0,0,0,0, 0, 0, 0);
+        t2.condvec[1] = mk(F_VILLAGE, -6000,-6000, 6000, 6000, 1, 0, 1);
+        t2.references[0] = {1};
+        GpuFilter g2; QString i2;
+        CHECK(g2.init(t2, mc, &i2), "init2 failed: %s", i2.c_str());
+        uint64_t n = (1u << 21) + 12345, base = 5000000000ULL;
+        std::vector<uint64_t> got;
+        CHECK(g2.filterRange(base, n, got, nullptr), "overflow range failed");
+        std::set<uint64_t> gs(got.begin(), got.end());
+        CHECK(gs.size() == got.size(), "duplicates after overflow split");
+        size_t exp = 0, miss = 0;
+        for (uint64_t i = 0; i < n; i++)
+        {
+            bool r = refCond(t2.condvec[1], mc, base + i);
+            exp += r;
+            if (r && !gs.count(base + i)) miss++;
+        }
+        CHECK(gs.size() == exp && miss == 0, "overflow case: got %zu expected %zu missing %zu", gs.size(), exp, miss);
+        printf("overflow split: %zu survivors, exact\n", exp);
+    }
+
+    // 5) tree without usable conditions
+    {
+        ConditionTree t3; t3.condvec.resize(2); t3.references.resize(2);
+        t3.condvec[0] = mk(F_SELECT, 0,0,0,0, 0, 0, 0);
+        t3.condvec[1] = mk(F_BIOME, 0,0,10,10, 1, 0, 1);
+        t3.references[0] = {1};
+        GpuFilter g3; QString i3;
+        CHECK(!g3.init(t3, mc, &i3), "init should refuse a tree with nothing to prefilter");
+        printf("no-op tree: \"%s\"\n", i3.c_str());
+    }
+
+    printf(fails ? "RESULT: %d failure(s)\n" : "RESULT: all host tests passed\n", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tests/gpu_kernel_test.cpp b/tests/gpu_kernel_test.cpp
new file mode 100644
index 0000000..829ee85
--- /dev/null
+++ b/tests/gpu_kernel_test.cpp
@@ -0,0 +1,162 @@
+// Verifies the OpenCL prefilter kernel logic (src/gpukernel.cl) on the CPU by
+// including it as C++ and comparing against cubiomes' getStructurePos.
+//
+//   exact kinds (feature/large): kernel result must equal reference result
+//   outpost: kernel must never reject a seed the reference accepts
+//
+// Build/run: see tests/run_gpu_kernel_test.sh
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+
+extern "C" {
+#include "../cubiomes/finders.h"
+}
+
+// ---- shim for OpenCL C types/qualifiers --------------------------------
+typedef uint64_t ulong;
+typedef int64_t  slong;
+typedef uint32_t uint;
+#define __constant
+#define __global
+#define __kernel
+#include "../src/gpukernel.cl"
+static_assert(sizeof(GkCond) == 64, "GkCond layout must match host GpuCond");
+
+static int refCount(int st, int mc, uint64_t seed, const GkCond& c)
+{
+    int cnt = 0;
+    for (int rz = c.rz1; rz <= c.rz2; rz++)
+    {
+        for (int rx = c.rx1; rx <= c.rx2; rx++)
+        {
+            Pos p;
+            if (!getStructurePos(st, mc, seed, rx, rz, &p))
+                continue;
+            if (c.useRadius)
+            {
+                int64_t rsq = p.x * (int64_t)p.x + p.z * (int64_t)p.z;
+                if (rsq >= (int64_t)c.rmaxsq)
+                    continue;
+            }
+            else if (p.x < c.x1 || p.x > c.x2 || p.z < c.z1 || p.z > c.z2)
+                continue;
+            cnt++;
+        }
+    }
+    return cnt;
+}
+
+static int floordivi(int a, int b)
+{
+    int q = a / b;
+    if ((a % b != 0) && ((a < 0) != (b < 0)))
+        q--;
+    return q;
+}
+
+int main()
+{
+    struct T { int st; int kind; const char *name; };
+    const T types[] = {
+        { Desert_Pyramid, GK_FEATURE, "desert" },
+        { Jungle_Pyramid, GK_FEATURE, "jungle" },
+        { Swamp_Hut,      GK_FEATURE, "hut" },
+        { Igloo,          GK_FEATURE, "igloo" },
+        { Village,        GK_FEATURE, "village" },
+        { Ocean_Ruin,     GK_FEATURE, "ruins" },
+        { Shipwreck,      GK_FEATURE, "shipwreck" },
+        { Ruined_Portal,  GK_FEATURE, "portal" },
+        { Ruined_Portal_N,GK_FEATURE, "portal_n" },
+        { Ancient_City,   GK_FEATURE, "ancient_city" },
+        { Trail_Ruins,    GK_FEATURE, "trails" },
+        { Trial_Chambers, GK_FEATURE, "chambers" },
+        { Monument,       GK_LARGE,   "monument" },
+        { Mansion,        GK_LARGE,   "mansion" },
+        { Outpost,        GK_OUTPOST, "outpost" },
+    };
+    const int mcs[] = {
+        MC_1_7, MC_1_9, MC_1_12, MC_1_13, MC_1_15, MC_1_16_1, MC_1_17,
+        MC_1_18, MC_1_19, MC_1_20, MC_1_21_1,
+    };
+
+    std::mt19937_64 rng(12345);
+    long tested = 0, mismatches = 0, passes = 0, outposts_dropped = 0;
+
+    for (const T& t : types)
+    {
+        for (int mc : mcs)
+        {
+            StructureConfig sc;
+            if (!getStructureConfig(t.st, mc, &sc))
+                continue;
+
+            for (int iter = 0; iter < 400; iter++)
+            {
+                GkCond c;
+                memset(&c, 0, sizeof(c));
+                c.salt = sc.salt;
+                c.regionSize = sc.regionSize;
+                c.chunkRange = sc.chunkRange;
+                c.kind = t.kind;
+                c.count = 1 + (int)(rng() % 3);
+
+                int x1 = (int)(rng() % 8001) - 4000;
+                int z1 = (int)(rng() % 8001) - 4000;
+                int span = (iter % 2) ? 3000 : 300; // half the cases use small areas (more rejections)
+                int w = 16 + (int)(rng() % span);
+                int h = 16 + (int)(rng() % span);
+                int rs = sc.regionSize << 4;
+
+                if (rng() % 3 == 0)
+                {   // radius mode, like cond->rmax
+                    int rmax = 32 + (int)(rng() % ((iter % 2) ? 2500 : 300));
+                    int r1 = rmax - 1;
+                    c.x1 = -r1; c.z1 = -r1; c.x2 = r1; c.z2 = r1;
+                    c.useRadius = 1;
+                    c.rmaxsq = (uint64_t)((int64_t)r1 * r1 + 1);
+                }
+                else
+                {
+                    c.x1 = x1; c.z1 = z1; c.x2 = x1 + w; c.z2 = z1 + h;
+                }
+                c.rx1 = floordivi(c.x1, rs);
+                c.rz1 = floordivi(c.z1, rs);
+                c.rx2 = floordivi(c.x2, rs);
+                c.rz2 = floordivi(c.z2, rs);
+
+                for (int k = 0; k < 40; k++)
+                {
+                    uint64_t seed = rng();
+                    if (k % 4 == 0) seed &= 0xffffffffffffULL;
+                    int ref = refCount(t.st, mc, seed, c) >= c.count;
+                    int got = gk_cond_passes(&c, seed);
+                    tested++;
+                    passes += got;
+                    if (t.kind == GK_OUTPOST)
+                    {
+                        if (ref && !got)
+                        {
+                            mismatches++;
+                            outposts_dropped++;
+                        }
+                    }
+                    else if (ref != got)
+                    {
+                        if (mismatches < 10)
+                            printf("MISMATCH %s mc=%d seed=%llu ref=%d got=%d\n",
+                                t.name, mc, (unsigned long long)seed, ref, got);
+                        mismatches++;
+                    }
+                }
+            }
+        }
+    }
+
+    printf("tested=%ld kernel_passes=%ld mismatches=%ld (outpost false negatives=%ld)\n",
+        tested, passes, mismatches, outposts_dropped);
+    return mismatches ? 1 : 0;
+}
diff --git a/tests/mock_opencl.cpp b/tests/mock_opencl.cpp
new file mode 100644
index 0000000..3a5d469
--- /dev/null
+++ b/tests/mock_opencl.cpp
@@ -0,0 +1,120 @@
+// A CPU "OpenCL driver" for testing the host code in src/gpusearch.cpp.
+// It implements just the entry points the host uses and runs the kernel logic
+// (src/gpukernel.cl, included as C++) in plain loops. Results are produced in
+// reverse order on purpose, like unordered GPU atomics.
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <vector>
+#include <string>
+#include "../src/cl_min.h"
+
+typedef uint64_t ulong;
+typedef int64_t  slong;
+typedef uint32_t uint;
+#define __constant
+#define __global
+#define __kernel
+#include "../src/gpukernel.cl"
+
+struct MBuf { std::vector<unsigned char> d; };
+struct MKernel { bool isList; std::vector<std::vector<unsigned char>> args; };
+struct MProg { std::string src; };
+
+#define API extern "C" __attribute__((visibility("default")))
+
+static int g_plat, g_dev;
+long g_mock_launches = 0;
+API long mock_launch_count() { return g_mock_launches; }
+
+API cl_int CL_API_CALL clGetPlatformIDs(cl_uint n, cl_platform_id *p, cl_uint *np)
+{ if (np) *np = 1; if (p && n) p[0] = (cl_platform_id)&g_plat; return CL_SUCCESS; }
+API cl_int CL_API_CALL clGetDeviceIDs(cl_platform_id, cl_device_type t, cl_uint n, cl_device_id *d, cl_uint *nd)
+{
+    if (!(t & CL_DEVICE_TYPE_GPU)) { if (nd) *nd = 0; return -1; }
+    if (nd) *nd = 1; if (d && n) d[0] = (cl_device_id)&g_dev; return CL_SUCCESS;
+}
+API cl_int CL_API_CALL clGetDeviceInfo(cl_device_id, cl_device_info i, size_t sz, void *v, size_t *r)
+{
+    if (r) *r = 0;
+    switch (i) {
+    case CL_DEVICE_AVAILABLE: case CL_DEVICE_COMPILER_AVAILABLE: *(cl_bool*)v = 1; break;
+    case CL_DEVICE_MAX_COMPUTE_UNITS: *(cl_uint*)v = 8; break;
+    case CL_DEVICE_HOST_UNIFIED_MEMORY: *(cl_bool*)v = 0; break;
+    case CL_DEVICE_NAME: snprintf((char*)v, sz, "Mock GPU (CPU emulation)"); break;
+    default: break;
+    }
+    return CL_SUCCESS;
+}
+API cl_context CL_API_CALL clCreateContext(const cl_context_properties*, cl_uint, const cl_device_id*, void (CL_API_CALL *)(const char*, const void*, size_t, void*), void*, cl_int *e)
+{ *e = CL_SUCCESS; return (cl_context)new int(1); }
+API cl_command_queue CL_API_CALL clCreateCommandQueue(cl_context, cl_device_id, cl_command_queue_properties, cl_int *e)
+{ *e = CL_SUCCESS; return (cl_command_queue)new int(2); }
+API cl_program CL_API_CALL clCreateProgramWithSource(cl_context, cl_uint, const char **s, const size_t *l, cl_int *e)
+{ *e = CL_SUCCESS; MProg *p = new MProg; p->src.assign(s[0], l[0]); return (cl_program)p; }
+API cl_int CL_API_CALL clBuildProgram(cl_program p, cl_uint, const cl_device_id*, const char *opt, void (CL_API_CALL *)(cl_program, void*), void*)
+{
+    MProg *m = (MProg*)p;
+    if (!opt || !strstr(opt, "-DGK_OPENCL")) return -11;           // CL_BUILD_PROGRAM_FAILURE
+    if (m->src.find("gk_filter_range") == std::string::npos) return -11;
+    return CL_SUCCESS;
+}
+API cl_int CL_API_CALL clGetProgramBuildInfo(cl_program, cl_device_id, cl_program_build_info, size_t, void *v, size_t *r)
+{ if (r) *r = 1; if (v) *(char*)v = 0; return CL_SUCCESS; }
+API cl_kernel CL_API_CALL clCreateKernel(cl_program, const char *name, cl_int *e)
+{
+    MKernel *k = new MKernel; k->args.resize(8);
+    if (!strcmp(name, "gk_filter_range")) k->isList = false;
+    else if (!strcmp(name, "gk_filter_list")) k->isList = true;
+    else { *e = -46; delete k; return nullptr; }
+    *e = CL_SUCCESS; return (cl_kernel)k;
+}
+API cl_mem CL_API_CALL clCreateBuffer(cl_context, cl_mem_flags f, size_t sz, void *host, cl_int *e)
+{
+    MBuf *b = new MBuf; b->d.assign(sz, 0);
+    if ((f & CL_MEM_COPY_HOST_PTR) && host) memcpy(b->d.data(), host, sz);
+    *e = CL_SUCCESS; return (cl_mem)b;
+}
+API cl_int CL_API_CALL clEnqueueWriteBuffer(cl_command_queue, cl_mem m, cl_bool, size_t off, size_t sz, const void *p, cl_uint, const cl_event*, cl_event*)
+{ MBuf *b = (MBuf*)m; if (off + sz > b->d.size()) return -30; memcpy(b->d.data() + off, p, sz); return CL_SUCCESS; }
+API cl_int CL_API_CALL clEnqueueReadBuffer(cl_command_queue, cl_mem m, cl_bool, size_t off, size_t sz, void *p, cl_uint, const cl_event*, cl_event*)
+{ MBuf *b = (MBuf*)m; if (off + sz > b->d.size()) return -30; memcpy(p, b->d.data() + off, sz); return CL_SUCCESS; }
+API cl_int CL_API_CALL clSetKernelArg(cl_kernel k, cl_uint i, size_t sz, const void *v)
+{
+    MKernel *m = (MKernel*)k; if (i >= 8) return -49;
+    m->args[i].assign((const unsigned char*)v, (const unsigned char*)v + sz); return CL_SUCCESS;
+}
+template<class T> static T arg(MKernel *k, int i) { T v; memcpy(&v, k->args[i].data(), sizeof(T)); return v; }
+
+API cl_int CL_API_CALL clEnqueueNDRangeKernel(cl_command_queue, cl_kernel kk, cl_uint, const size_t*, const size_t *gws, const size_t*, cl_uint, const cl_event*, cl_event*)
+{
+    MKernel *k = (MKernel*)kk;
+    g_mock_launches++;
+    MBuf *conds = arg<MBuf*>(k, 0);
+    int nconds = arg<int>(k, 1);
+    if (nconds < 1 || nconds > GK_MAX_CONDS || conds->d.size() < (size_t)nconds * sizeof(GkCond)) return -30;
+    const GkCond *cv = (const GkCond*)conds->d.data();
+    ulong start = 0; MBuf *list = nullptr;
+    if (k->isList) list = arg<MBuf*>(k, 2); else start = arg<ulong>(k, 2);
+    ulong total = arg<ulong>(k, 3);
+    MBuf *out = arg<MBuf*>(k, 4);
+    MBuf *cnt = arg<MBuf*>(k, 5);
+    uint cap = arg<uint>(k, 6);
+    if (out->d.size() < (size_t)cap * 8) return -30;
+    uint *pc = (uint*)cnt->d.data();
+    ulong *po = (ulong*)out->d.data();
+    for (ulong g = *gws; g-- > 0;)
+    {
+        if (g >= total) continue;
+        ulong seed = k->isList ? ((ulong*)list->d.data())[g] : start + g;
+        if (gk_seed_passes(cv, nconds, seed)) { uint idx = (*pc)++; if (idx < cap) po[idx] = seed; }
+    }
+    return CL_SUCCESS;
+}
+API cl_int CL_API_CALL clFinish(cl_command_queue) { return CL_SUCCESS; }
+API cl_int CL_API_CALL clReleaseMemObject(cl_mem m) { delete (MBuf*)m; return CL_SUCCESS; }
+API cl_int CL_API_CALL clReleaseKernel(cl_kernel k) { delete (MKernel*)k; return CL_SUCCESS; }
+API cl_int CL_API_CALL clReleaseProgram(cl_program p) { delete (MProg*)p; return CL_SUCCESS; }
+API cl_int CL_API_CALL clReleaseCommandQueue(cl_command_queue) { return CL_SUCCESS; }
+API cl_int CL_API_CALL clReleaseContext(cl_context) { return CL_SUCCESS; }
